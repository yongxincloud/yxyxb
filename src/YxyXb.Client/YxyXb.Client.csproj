<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>YxyXb.Client</RootNamespace>
    <AssemblyName>YxyXb.Client</AssemblyName>
    <OutputPath>$(SolutionDir)dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>..\YxyXb.img\logo.ico</ApplicationIcon>
    <StartupObject>YxyXb.Client.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\YxyXb.img\logo.ico">
      <Link>Assets\logo.ico</Link>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YxyXb.Contracts\YxyXb.Contracts.csproj" />
    <ProjectReference Include="..\YxyXb.Core\YxyXb.Core.csproj" />
    <ProjectReference Include="..\YxyXb.Media\YxyXb.Media.csproj" />
    <ProjectReference Include="..\YxyXb.Mssql\YxyXb.Mssql.csproj" />
    <ProjectReference Include="..\YxyXb.MySql\YxyXb.MySql.csproj" />
    <ProjectReference Include="..\YxyXb.Cloud\YxyXb.Cloud.csproj" />
    <ProjectReference Include="..\YxyXb.Baidu\YxyXb.Baidu.csproj" />
    <ProjectReference Include="..\YxyXb.SiteSession\YxyXb.SiteSession.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\YxyXb.Baidu\BaiduApp.example.json" Link="BaiduApp.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="oem.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
  </ItemGroup>
  <Target Name="IncludeEmptyBak" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)bak" />
    <Touch Files="$(TargetDir)bak\.keep" AlwaysCreate="true" Condition="!Exists('$(TargetDir)bak\.keep')" />
  </Target>
  <Target Name="IncludeEmptyBakPublish" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <_BakKeep>$(IntermediateOutputPath)bak\.keep</_BakKeep>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)bak" />
    <Touch Files="$(_BakKeep)" AlwaysCreate="true" Condition="!Exists('$(_BakKeep)')" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_BakKeep)">
        <RelativePath>bak/.keep</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="IncludeSQLiteInteropPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_SQLiteInteropX64 Include="$(NuGetPackageRoot)stub.system.data.sqlite.core.netframework\1.0.118\build\net46\x64\SQLite.Interop.dll">
        <RelativePath>x64\SQLite.Interop.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </_SQLiteInteropX64>
      <_SQLiteInteropX86 Include="$(NuGetPackageRoot)stub.system.data.sqlite.core.netframework\1.0.118\build\net46\x86\SQLite.Interop.dll">
        <RelativePath>x86\SQLite.Interop.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </_SQLiteInteropX86>
      <ResolvedFileToPublish Include="@(_SQLiteInteropX64);@(_SQLiteInteropX86)" />
    </ItemGroup>
  </Target>
</Project>
