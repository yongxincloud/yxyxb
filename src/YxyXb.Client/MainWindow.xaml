<Window x:Class="YxyXb.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="用心云·循备"
        x:Name="RootWindow"
        Icon="pack://application:,,,/Assets/logo.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBg}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="Microsoft YaHei"
        FontFamily="Microsoft YaHei">
    <Border BorderBrush="{DynamicResource CardLine}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="228" Background="{DynamicResource NavBg}">
                <DockPanel>
                    <StackPanel x:Name="Brand" DockPanel.Dock="Top" Margin="16,22,16,16" MouseLeftButtonDown="Drag_OnDown">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="ImgLogo" Source="pack://application:,,,/Assets/logo.ico" Width="28" Height="28" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtBrand" Text="用心云·循备" Foreground="{DynamicResource NavText}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtBrandSub" Text="常州用心软件有限公司" Foreground="{DynamicResource Accent}" FontSize="11" Margin="38,4,0,0"/>
                        <TextBlock x:Name="TxtBrandPhone" Text="" Foreground="{DynamicResource Muted}" FontSize="11" Margin="38,2,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtVersion" Text="Ver 1.0.0" Foreground="{DynamicResource Muted}" FontSize="11" Margin="38,2,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12">
                        <Button x:Name="BtnSite" Style="{StaticResource NavButton}" Click="BtnSite_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Web" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="官网" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnLogin" Style="{StaticResource NavButton}" Margin="0" Click="BtnLogin_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Login" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock x:Name="TxtLogin" Text="登录" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnWindow" Grid.Column="1" Style="{StaticResource NavButton}" Margin="4,0,0,0" Click="BtnWindow_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="退出" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0">
                        <Button x:Name="NavHome" Style="{StaticResource NavButton}" Tag="home" Click="Nav_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Home" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="首页" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTasks" Style="{StaticResource NavButton}" Tag="tasks" Click="Nav_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListChecks" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="任务" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavCloud" Style="{StaticResource NavButton}" Tag="cloud" Click="Nav_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudUpload" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="云备份" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavInstances" Style="{StaticResource NavButton}" Tag="instances" Click="Nav_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Database" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="库实例" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Tag="logs" Click="Nav_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextBoxOutline" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="操作日志" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavRestore" Style="{StaticResource NavButton}" Tag="restore" Click="Nav_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BackupRestore" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="实例恢复" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavMedia" Style="{StaticResource NavButton}" Tag="media" Click="Nav_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Harddisk" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="离线介质" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDevices" Style="{StaticResource NavButton}" Tag="devices" Click="Nav_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Monitor" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="我的设备" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="settings" Click="Nav_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="系统设置" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel Background="{DynamicResource PageBg}">
                <Border x:Name="TitleBar" DockPanel.Dock="Top" BorderBrush="{DynamicResource CardLine}" BorderThickness="0,0,0,1" Margin="0,0,0,8" MouseLeftButtonDown="Drag_OnDown">
                    <TextBlock x:Name="TxtTitle" Text="首页" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TitleText}" Margin="24,18,24,14"/>
                </Border>
                <ContentControl x:Name="PageHost" Margin="20,4,20,16"/>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
