<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Yxy.Engine</RootNamespace>
    <AssemblyName>Yxy.Engine</AssemblyName>
    <OutputPath>$(SolutionDir)dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Yxy.img\logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yxy.Contracts\Yxy.Contracts.csproj" />
    <ProjectReference Include="..\Yxy.Core\Yxy.Core.csproj" />
    <ProjectReference Include="..\Yxy.Media\Yxy.Media.csproj" />
    <ProjectReference Include="..\Yxy.Mssql\Yxy.Mssql.csproj" />
    <ProjectReference Include="..\Yxy.Cloud\Yxy.Cloud.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Yxy.Baidu\BaiduApp.example.json" Link="BaiduApp.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
