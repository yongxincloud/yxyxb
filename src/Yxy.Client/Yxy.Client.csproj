<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Yxy.Client</RootNamespace>
    <AssemblyName>Yxy.Client</AssemblyName>
    <OutputPath>$(SolutionDir)dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>..\Yxy.img\logo.ico</ApplicationIcon>
    <StartupObject>Yxy.Client.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\Yxy.img\logo.ico">
      <Link>Assets\logo.ico</Link>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yxy.Contracts\Yxy.Contracts.csproj" />
    <ProjectReference Include="..\Yxy.Core\Yxy.Core.csproj" />
    <ProjectReference Include="..\Yxy.Media\Yxy.Media.csproj" />
    <ProjectReference Include="..\Yxy.Mssql\Yxy.Mssql.csproj" />
    <ProjectReference Include="..\Yxy.MySql\Yxy.MySql.csproj" />
    <ProjectReference Include="..\Yxy.Cloud\Yxy.Cloud.csproj" />
    <ProjectReference Include="..\Yxy.Baidu\Yxy.Baidu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Yxy.Baidu\BaiduApp.example.json" Link="BaiduApp.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
  </ItemGroup>
</Project>
