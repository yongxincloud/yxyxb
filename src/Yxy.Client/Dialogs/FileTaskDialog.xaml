<Window x:Class="Yxy.Client.Dialogs.FileTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="添加文件备份任务"
        Style="{StaticResource YxyDialog}"
        Width="640"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="保存" Width="88" Height="36" Margin="0,0,8,0" IsDefault="True" Click="BtnOk_OnClick"/>
            <Button Content="取消" Width="88" Height="36" IsCancel="True"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="基本设置">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="名称" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtName" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>
                    <TextBlock Text="源" Grid.Row="1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbSource" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" SelectionChanged="CmbSource_OnChanged">
                        <ComboBoxItem Content="本地" Tag="local" IsSelected="True"/>
                        <ComboBoxItem Content="UNC" Tag="unc"/>
                        <ComboBoxItem Content="FTP" Tag="ftp"/>
                    </ComboBox>
                    <TextBlock Text="文件夹" Grid.Row="2" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPath" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                    <Button x:Name="BtnBrowse" Grid.Row="2" Grid.Column="2" Content="选择" Margin="8,4,0,4" Click="BtnBrowse_OnClick"/>
                    <TextBlock Text="重计时(分)" Grid.Row="3" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtRetry" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="5" Margin="0,4"/>
                    <TextBlock Text="排序" Grid.Row="4" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSort" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="0" Margin="0,4"/>
                    <CheckBox x:Name="ChkEnabled" Grid.Row="5" Grid.Column="1" Content="启用" IsChecked="True" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            <TabItem Header="计划周期">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="周期" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbCycle" Grid.Column="1" Margin="0,4">
                        <ComboBoxItem Content="分钟" Tag="minute"/>
                        <ComboBoxItem Content="小时" Tag="hour"/>
                        <ComboBoxItem Content="天" Tag="day" IsSelected="True"/>
                        <ComboBoxItem Content="每星期" Tag="week"/>
                        <ComboBoxItem Content="每月" Tag="month"/>
                        <ComboBoxItem Content="仅一次" Tag="once"/>
                    </ComboBox>
                    <TextBlock Text="间隔" Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtInterval" Grid.Row="1" Grid.Column="1" Text="1" Margin="0,4"/>
                    <TextBlock Text="下次执行" Grid.Row="2" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <DatePicker x:Name="DtNext" Width="180" Margin="0,4,8,4" FirstDayOfWeek="Monday" Language="zh-CN"/>
                        <md:TimePicker x:Name="TmNext" Width="140" Is24Hours="True" WithSeconds="False" Margin="0,4"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="任务设置">
                <StackPanel Margin="12">
                    <CheckBox x:Name="ChkNetwork" Content="网络传输（UNC）" Margin="0,6"/>
                    <CheckBox x:Name="ChkFtp" Content="FTP 上传" Margin="0,6"/>
                    <CheckBox x:Name="ChkCloud" Content="云上传" Margin="0,6"/>
                    <ComboBox x:Name="CmbCloud" Margin="0,0,0,6" Width="200" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="ChkDelete" Content="立即删本次本地包（默认不勾）" Margin="0,6" Checked="ChkDelete_OnChecked"/>
                    <CheckBox x:Name="ChkEmail" Content="完成后发邮件" Margin="0,6"/>
                    <TextBlock Text="完成后运行程序" Margin="0,12,0,4"/>
                    <TextBox x:Name="TxtPost" Height="26"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
